# ---------------------------------------------------------------------------
# MyTally backend configuration (copy to backend/.env and fill in values)
# Loaded by app/core/config.py via pydantic-settings.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Async MySQL URL. The database name at the end becomes the *portal* schema.
# Matches the credentials in the root docker-compose.yml.
DATABASE_URL=mysql+aiomysql://root:rootpassword@127.0.0.1:3306/mytally_db
# Second schema on the same MySQL server that mirrors Tally data.
TALLY_DATABASE_NAME=tally_sync
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- Optional -------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Set true for managed MySQL (Aiven, RDS). Put the CA bundle at backend/ca.pem.
DB_SSL=false

# Direct backend -> Tally push (only when the backend can reach Tally on the LAN/tunnel).
# Leave empty when using the Desktop Sync Agent.
TALLY_URL=

# Photo uploads (attendance selfies, payment proofs)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Outbound email
SMTP_USER=
SMTP_PASS=

# Web push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Android app push (Firebase). Firebase console > Project settings > Service accounts > Generate new private key.
# Save the file in backend/ as firebase-service-account.json (git ignores it) and point here; leave empty to turn off.
FCM_SERVICE_ACCOUNT_JSON=

# Payments
DEFAULT_UPI_VPA=
RAZORPAY_WEBHOOK_SECRET=

# GST provider adapter
GST_PROVIDER_URL=
GST_PROVIDER_API_KEY=

# Rate limiting / logging / pagination
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/minute; 20/hour
LOG_LEVEL=INFO
LOG_FORMAT=text

# ─── Added for the Livekeeping parity work (docs/livekeeping-parity-plan.md, Appendix A) ───
# Each feature also needs its switch in Admin → Integrations. Restart the backend after editing this file.

# Email reminders / emailing PDFs / backup copies through Gmail (A3). SMTP_USER and SMTP_PASS are above;
# SMTP_PASS must be a Google app password. Optional:
# SMTP_FROM_NAME=Your Company Name
# EMAIL_DAILY_LIMIT=450
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Automatic payment reminders: true = log what would be sent without sending. Set to false to go live.
REMINDERS_DRY_RUN=true

# WhatsApp reminders through Meta's WhatsApp Cloud API (A4)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=payment_reminder
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# e-Invoice / e-Way bill through the GST Suvidha Provider, MasterGST (A8). The e-invoice and e-way bill portal
# API usernames/passwords are entered in Admin → Integrations, not here.
GSP_EMAIL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
# GSP_PROVIDER=mastergst
# GSP_BASE_URL=https://api.mastergst.com
# GSP_IP_ADDRESS=127.0.0.1
